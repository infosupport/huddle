{
  "version": 1,
  "kind": "huddle-firewall-group",
  "group": {
    "name": "Node.js",
    "description": "Node.js runtime downloads in path mode: nodejs.org is blocked at the root, only the release/download paths pass.",
    "shared": true
  },
  "rules": [
    { "domain": "nodejs.org",                "container_id": null, "status": "deny",  "path_pattern": null,          "path_mode": 1, "expires_at": null },
    { "domain": "nodejs.org",                "container_id": null, "status": "allow", "path_pattern": "/dist/*",      "path_mode": 0, "expires_at": null },
    { "domain": "nodejs.org",                "container_id": null, "status": "allow", "path_pattern": "/download/*",  "path_mode": 0, "expires_at": null },
    { "domain": "raw.githubusercontent.com", "container_id": null, "status": "allow", "path_pattern": "/nodejs/*",    "path_mode": 0, "expires_at": null }
  ]
}
