# Huddle firewall compatibility test — test cases.
#
# This file is the single source of truth for BOTH run-test.sh and
# run-test.ps1 so the assertions stay identical across operating systems and
# container runtimes. It is intentionally plain `KEY=value` (no quoting, no
# shell/PowerShell syntax) so both a POSIX shell and PowerShell can parse it.
#
# Every value can be overridden from the environment: an already-exported
# variable of the same name wins over the default set here. That lets CI or a
# developer point the suite at other domains without editing this file.

# ── Allowed domain (must become reachable after an allow rule) ───────────────
# example.com is a stable, RFC 2606 documentation domain that answers plain
# HTTP with 200 — a clean, dependency-free "allowed" signal.
HUDDLE_TEST_ALLOWED_DOMAIN=example.com
HUDDLE_TEST_ALLOWED_URL=http://example.com/
HUDDLE_TEST_ALLOWED_EXPECT=200

# ── Blocked domain (must stay unreachable — default-deny) ────────────────────
# A .invalid host (RFC 6761) is guaranteed never to resolve and no one would
# ever allow it, so Huddle's default-deny returns 403 before it even tries to
# connect. Using a bogus host keeps the "blocked" assertion hermetic: it can
# never accidentally succeed because of a stray allow rule or real DNS.
HUDDLE_TEST_BLOCKED_URL=http://denied.huddle-firewall-test.invalid/
HUDDLE_TEST_BLOCKED_EXPECT=403

# ── Path mode (optional milestone-1 extra) ───────────────────────────────────
# A host that is closed at the host level but opened for one path prefix.
# example.org is intercepted (MITM) so Huddle can enforce per-path over HTTPS.
# The allowed path reaches upstream (any non-403 status); a sibling path is
# blocked by Huddle (403). We use a DIFFERENT domain than the allow test so the
# host-level allow rule there cannot mask the path-mode marker here.
HUDDLE_TEST_PATHMODE_DOMAIN=example.org
HUDDLE_TEST_PATHMODE_PATTERN=/allowed/*
HUDDLE_TEST_PATHMODE_ALLOWED_URL=https://example.org/allowed/page
HUDDLE_TEST_PATHMODE_BLOCKED_URL=https://example.org/blocked/page

# ── Minimal test devcontainer ────────────────────────────────────────────────
# A tiny, public image that already ships curl + a CA bundle. It attaches to
# Huddle's internal network and reaches the internet ONLY through the proxy, so
# it is a faithful stand-in for a real devcontainer without pulling the large
# IDE base images. Fully-qualified so Podman resolves it without prompting.
HUDDLE_TEST_CLIENT_IMAGE=docker.io/curlimages/curl:8.11.1
HUDDLE_TEST_CLIENT_NAME=huddle-fw-testclient
