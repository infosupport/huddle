{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
    'docker:pinDigests',
    'customManagers:githubActionsVersions', // updates `# renovate:` annotated *_VERSION env vars in workflows
  ],
  timezone: 'Europe/Amsterdam',
  // Demo project that is not shipped; keep it out of dependency PRs. (config:recommended already ignores test/examples folders.)
  ignorePaths: ['docker-demo/**'],
  // Hosted Renovate runs roughly every 4 hours; a "before 7am" window can be missed.
  schedule: ['* 0-11 * * 1'],
  labels: ['dependencies'],
  // Most hijacked npm releases are pulled within days. Security fixes skip this (see vulnerabilityAlerts).
  minimumReleaseAge: '3 days',

  lockFileMaintenance: {
    enabled: true,
    schedule: ['* 0-11 * * 1'],
    minimumReleaseAge: null, // has no release timestamp; would stay pending forever
    automerge: true,
  },

  vulnerabilityAlerts: {
    // This block overrides every packageRule. Keep automerge false here, or security
    // PRs for node-forge/fastify/ws/better-sqlite3 would merge without review.
    labels: ['dependencies', 'security'],
    automerge: false,
  },
  osvVulnerabilityAlerts: true, // experimental; direct dependencies only

  packageRules: [
    {
      description: 'Supported Node range in engines is a product decision, not an update',
      matchDepTypes: ['engines'],
      enabled: false,
    },
    {
      description: 'Dev tooling: patch + minor grouped, automerge on green',
      matchManagers: ['npm'],
      matchDepTypes: ['devDependencies'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'dev tooling (non-major)',
      automerge: true,
    },
    {
      description: 'Runtime patches: automerge on green',
      matchManagers: ['npm'],
      matchDepTypes: ['dependencies'],
      matchUpdateTypes: ['patch'],
      automerge: true,
    },
    {
      description: 'Angular moves as one unit; a person reviews it',
      matchPackageNames: ['@angular/**', '@angular-devkit/**', '@schematics/angular', 'zone.js', 'rxjs'],
      groupName: 'angular',
      automerge: false,
    },
    {
      description: "The frontend's TypeScript version is dictated by Angular",
      matchFileNames: ['gateway/frontend/package.json'],
      matchPackageNames: ['typescript'],
      groupName: 'angular',
      automerge: false,
    },
    {
      description: 'Node image and @types/node move together',
      matchPackageNames: ['node', '@types/node'],
      groupName: 'node runtime',
      automerge: false,
    },
    {
      description: 'Own GHCR images have no release timestamps',
      matchDatasources: ['docker'],
      matchPackageNames: ['ghcr.io/infosupport/**'],
      minimumReleaseAge: null,
    },
    {
      description: 'Digest pins and refreshes have no release timestamps',
      matchUpdateTypes: ['pinDigest', 'digest'],
      minimumReleaseAge: null,
    },
    {
      description: 'GitHub Actions: grouped, automerge on green',
      matchManagers: ['github-actions'],
      groupName: 'github actions',
      automerge: true,
    },
    {
      description: 'Majors are planned work: approve them from the Dependency Dashboard',
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
      automerge: false,
    },
    {
      description: 'Security-critical packages: always a human review. Keep this rule LAST (last match wins).',
      matchPackageNames: ['node-forge', 'fastify', '@fastify/**', 'ws', 'better-sqlite3'],
      automerge: false,
      addLabels: ['needs-security-review'],
      // TODO for maintainers: add reviewers: ['team:<org/team>'] once an owner is chosen.
    },
  ],
}
