.ijdevc/

# Claude Code / AI-tool state — local only, never commit
.claude/
**/.claude/
.claude/settings.local.json

# Runtime / debug logs (incl. rider-client-diagnose.log generated in workspaces)
*.log

# Ad-hoc devcontainer comparison / diagnose captures
rider_working.json
rider_not_working.json
compare-broken-devcontainer-empty1.json
compare-working-devcontainer-empty2.json
.idea/

# Feature planning docs — local only, not for remote
features/
.worktrees/

# npm auth token — nooit committen
.npmrc

# Lokaal GitHub-token — nooit committen
github.txt

# Huddle audit logs — runtime data, niet voor versiebeheer
.audit/

# Dependencies
node_modules/
# left behind by dev-install.sh when Windows still has a file in there mapped
node_modules.old-*/

# Build output
dist/

# SEA build output: a ~130 MB binary plus its blob and sourcemap.
gateway/build/

# Stray/self-referential nested CLI package (accidental) — never commit
cli/cli/

/aikido

# AI agent config tree — beheerd buiten versiebeheer
/.ai

# Interne presentatie/binaries — niet voor de publieke repo
*.pptx

# Local firewall-rule exports. `huddle firewall export --out rules.json` run from
# the repo root drops a dump of the operator's own rules (container names,
# internal IPs) here; the shareable examples live in examples/firewall-rules/.
/rules.json

# Ad-hoc portal screenshots saved straight from the browser
localhost_3000_*.png

# lokale Aikido API-credentials (niet committen)
.aikido.env

# native dev run: local DB, CA and operator token (dev-native.ps1)
.huddle-native/

# design-sync (claude.ai/design)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
gateway/frontend/.ds-entry.mjs
